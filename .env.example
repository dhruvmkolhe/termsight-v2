# TermSight AI - Environment Configuration Template
# Copy this file to .env and fill in your keys:

# --- AI Provider API Keys (At least one is recommended, or heuristic fallback is used) ---
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Optional Alternative Providers:
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here

# --- Supabase Configuration (Optional / If using cloud persistence) ---
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Analytics & Telemetry (Optional) ---
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
# VITE_GA_MEASUREMENT_ID=your_ga4_measurement_id_here

# Plausible Analytics Domain (e.g. termsight.app)
# VITE_PLAUSIBLE_DOMAIN=your_plausible_domain_here

